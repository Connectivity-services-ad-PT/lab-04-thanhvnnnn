{
  "info": {
    "name": "Team Notify - API Tests",
    "description": "Complete test suite for Notify Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has status ok\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"ok\");",
              "});",
              "",
              "pm.test(\"Response has service name\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.service).to.eql(\"notify-service\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Send Email Notification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 202\", function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "",
              "pm.test(\"Response has notification_id\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"notification_id\");",
              "    pm.expect(jsonData.notification_id.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Response has message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"type\": \"email\",\n    \"recipient\": \"student@fit.edu.vn\",\n    \"subject\": \"Smart Campus Alert\",\n    \"message\": \"Temperature sensor exceeded threshold: 35.5°C\",\n    \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": ["{{base_url}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "Send SMS Notification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 202\", function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "",
              "pm.test(\"Response has success true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"type\": \"sms\",\n    \"recipient\": \"+84912345678\",\n    \"message\": \"Gate A3 access granted\",\n    \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": ["{{base_url}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "Negative Test - Missing Required Field",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 422 or 400\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"type\": \"email\",\n    \"recipient\": \"test@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": ["{{base_url}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "Negative Test - Invalid Email Format",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Response has error details\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"detail\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"type\": \"email\",\n    \"recipient\": \"invalid-email\",\n    \"subject\": \"Test\",\n    \"message\": \"Test message\",\n    \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": ["{{base_url}}"],
          "path": ["notifications"]
        }
      }
    },
    {
      "name": "Boundary Test - Long Message",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 202\", function () {",
              "    pm.response.to.have.status(202);",
              "});",
              "",
              "pm.test(\"Response is successful\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"type\": \"email\",\n    \"recipient\": \"test@example.com\",\n    \"subject\": \"Long Message Test\",\n    \"message\": \"Lorem ipsum dolor sit amet, consectetur adipiscing elit. \" + \"Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. \" + \"Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris. \" + \"Duis aute irure dolor in reprehenderit in voluptate velit esse cillum. \" + \"This is a very long message to test boundary conditions. \" + \"The service should handle this without any issues. \" + \"Repeating content to make it even longer... \" + \"Lorem ipsum dolor sit amet, consectetur adipiscing elit. \" + \"Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. \" + \"Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris. \" + \"Duis aute irure dolor in reprehenderit in voluptate velit esse cillum. \",\n    \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notifications",
          "host": ["{{base_url}}"],
          "path": ["notifications"]
        }
      }
    }
  ]
}