# Application Configuration
APP_NAME=Notify Service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Mock Mode - No real notifications sent
NOTIFY_MOCK_MODE=true

# Rate Limiting (disabled for lab)
RATE_LIMIT_PER_MINUTE=60

# Validation
MAX_MESSAGE_LENGTH=1000

# Security (for production - NOT for lab)
# NOTIFICATION_API_KEY=your-api-key-here
# SMS_API_KEY=your-sms-api-key
# EMAIL_SMTP_PASSWORD=your-smtp-password