{
  "name": "fit4110-lab04-team-notify-docker",
  "version": "1.0.0",
  "description": "FIT4110 Lab 04 Docker packaging tests for Team Notify",
  "private": true,
  "scripts": {
    "lint:openapi": "spectral lint --fail-severity error contracts/notify.openapi.yaml",
    "validate:contract": "npm run lint:openapi",
    "mock:server": "prism mock contracts/notify.openapi.yaml --host 0.0.0.0 --port 4010",
    "test:mock": "newman run postman/collections/team_notify.postman_collection.json -e postman/environments/team_notify_mock.postman_environment.json -r cli,htmlextra,junit --reporter-htmlextra-export reports/newman-lab04-mock.html --reporter-junit-export reports/newman-lab04-mock.xml",
    "test:local": "newman run postman/collections/team_notify.postman_collection.json -e postman/environments/team_notify_local.postman_environment.json -r cli,htmlextra,junit --reporter-htmlextra-export reports/newman-lab04-local.html --reporter-junit-export reports/newman-lab04-local.xml",
    "test:docker": "npm run test:local"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.13.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^8.0.1"
  },
  "keywords": [
    "fit4110",
    "docker",
    "notification-service",
    "newman"
  ],
  "author": "Team Notify",
  "license": "MIT"
}
