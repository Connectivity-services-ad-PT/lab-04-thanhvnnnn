{
  "name": "fit4110-notify-docker-test",
  "version": "1.0.0",
  "description": "Postman/Newman tests for Notify Service",
  "scripts": {
    "install:newman": "npm install -g newman newman-reporter-html newman-reporter-junit",
    "test:mock": "newman run postman/collections/team_notify.postman_collection.json -e postman/environments/team_notify_mock.postman_environment.json --reporters cli,html,junit --reporter-html-export reports/newman/newman-mock.html --reporter-junit-export reports/newman/newman-mock.xml",
    "test:local": "newman run postman/collections/team_notify.postman_collection.json -e postman/environments/team_notify_local.postman_environment.json --reporters cli,html,junit --reporter-html-export reports/newman/newman-local.html --reporter-junit-export reports/newman/newman-local.xml",
    "test:docker": "echo 'Make sure Docker container is running on port 8000' && npm run test:local",
    "validate:contract": "npx @stoplight/spectral lint contracts/notify.openapi.yaml",
    "mock:server": "npx @stoplight/prism mock contracts/notify.openapi.yaml --port 4010",
    "test:all": "npm run validate:contract && npm run test:mock && npm run test:local"
  },
  "devDependencies": {
    "@stoplight/spectral": "^6.11.0",
    "@stoplight/prism-cli": "^5.5.2"
  },
  "keywords": [
    "postman",
    "newman",
    "docker",
    "notification-service",
    "fit4110"
  ],
  "author": "Team Notify",
  "license": "MIT"
}